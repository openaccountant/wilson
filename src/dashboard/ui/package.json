{
  "name": "wilson-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:hybrid": "vite build --config vite.hybrid.config.ts && vite build --config vite.prelabel.config.ts && bun run ../../../scripts/copy-ort-web-assets.ts && bun run ../../../scripts/check-prelabel-bundle.ts && bun run ../../../scripts/check-hybrid-build.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "csv-parse": "^7.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.3",
    "remark-gfm": "^4.0.1",
    "wa-sqlite": "1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.5.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
