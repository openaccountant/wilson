{
  "name": "flow1-help-import",
  "width": 1400,
  "height": 860,
  "fontSize": 18,
  "typingSpeedMs": 120,
  "theme": {
    "background": "#0a0f1a",
    "foreground": "#e5e7eb",
    "cursor": "#22c55e",
    "selection": "#166534"
  },
  "output": "demos/tape-video/flow1-help-import.mp4",
  "steps": [
    { "type": "type", "text": "./demos/scripts/run-demo.sh", "enter": true },
    { "type": "sleep", "seconds": 8 },
    { "type": "shot", "file": "f1-00-boot.png" },

    { "type": "type", "text": "/help", "enter": true },
    { "type": "sleep", "seconds": 4 },
    { "type": "shot", "file": "f1-01-help.png" },

    { "type": "type", "text": "/", "enter": false },
    { "type": "sleep", "seconds": 2.5 },
    { "type": "shot", "file": "f1-02-palette.png" },

    { "type": "type", "text": "import demos/fixtures/august-2026-chase.csv", "enter": false },
    { "type": "sleep", "seconds": 0.8 },
    { "type": "type", "text": "", "enter": true },
    { "type": "sleep", "seconds": 22 },
    { "type": "shot", "file": "f1-03-imported.png" },
    { "type": "sleep", "seconds": 2 }
  ]
}
