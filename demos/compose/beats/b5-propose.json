{
  "id": "b5-propose",
  "kicker": "OPEN ACCOUNTANT / BEAT 5",
  "titleLead": "It proposes.",
  "titleAccent": "You decide.",
  "subtitle": "A real recording: an AI agent over WebMCP, a confirmation card for every change, a human who reads each one and decides.",
  "headerTitle": "It proposes. You decide.",
  "terminalTitle": "Agent (Claude Code, headless) — via WebMCP",
  "target": "SQ *KILN & CO STUDIO",
  "titleSeconds": 4,
  "requiredEvents": [
    "ledger-before",
    "grants-applied",
    "ledger-after",
    "beat-end"
  ],
  "requireTargetCard": true,
  "binding": {
    "strategy": "categorize-by-id",
    "requireBinding": true
  },
  "cards": {
    "rowMatch": "^categor"
  },
  "endHold": {
    "event": "ledger-after",
    "minSeconds": 2.5
  },
  "noCardAfter": "ledger-after",
  "zoom": {
    "ease": 0.6,
    "card": {
      "kinds": [
        "change"
      ],
      "rect": {
        "x": 0.75,
        "y": 0.72,
        "w": 0.245,
        "h": 0.27
      },
      "pad": 0.03,
      "maxScale": 2.6,
      "holdAfter": 0.6
    }
  },
  "segments": [
    {
      "from": {
        "event": "ledger-before",
        "offset": -2
      },
      "to": {
        "event": "grants-applied",
        "offset": 5
      }
    },
    {
      "from": {
        "cmd": "lastBeforeFirstProposal",
        "offset": -1
      },
      "to": {
        "event": "last-card-resolved",
        "offset": 3
      }
    },
    {
      "from": {
        "event": "ledger-after",
        "offset": -1.2
      },
      "to": {
        "event": "beat-end"
      }
    }
  ],
  "callouts": [
    {
      "id": "co1",
      "at": {
        "event": "grants-applied",
        "offset": -0.4
      },
      "end": {
        "event": "grants-applied",
        "offset": 4.6
      },
      "x": 400,
      "y": 300,
      "txt": "Agent sees only the tools you granted",
      "sub": "{@grants-applied.tools}"
    }
  ],
  "captions": [
    {
      "at": {
        "event": "ledger-before",
        "offset": -2
      },
      "end": {
        "event": "grants-applied",
        "offset": -0.4
      },
      "t": "Real recording. The row {target}, -$240.00 is still Uncategorized."
    },
    {
      "at": {
        "event": "grants-applied",
        "offset": -0.4
      },
      "end": {
        "seg": 0,
        "edge": "e"
      },
      "t": "Access grants applied in the dashboard: {@grants-applied.tools}."
    },
    {
      "at": {
        "seg": 1,
        "edge": "s"
      },
      "end": {
        "event": "first-proposal"
      },
      "t": "The agent reads before it proposes: read-only tool calls, then a lookup.",
      "optional": true
    },
    {
      "at": {
        "seg": 2,
        "edge": "s"
      },
      "end": {
        "seg": 2,
        "edge": "e"
      },
      "t": "Ledger afterwards, search cleared: {nApproved} approved, {nRejected} rejected. {target} {targetIs}"
    }
  ],
  "perCard": {
    "resolvedHold": 1.5,
    "propose": "The agent proposes categorize_transaction {proposalArgs}. It chose {category} itself.",
    "shown": "Card for transaction #{txId}: {before} → {category}. Nothing has changed yet.",
    "hold": "The human has read it and holds Approve for #{txId}.",
    "resolved": {
      "approve": "“Done. The change was applied.” (#{txId} is now {category})",
      "reject": "The human rejects #{txId}. Nothing was changed.",
      "rejectOther": "Not the {target} charge, so the human rejects #{txId}. Nothing was changed."
    },
    "coShown": {
      "x": 30,
      "y": 20,
      "txt": "Before → after computed by the server",
      "sub": "#{txId} · {before} → {category}",
      "src": "src/dashboard/webmcp-bridge.ts:214 · the card shows the before/after “the server computed in prepare”"
    },
    "coDecide": {
      "approve": {
        "txt": "Nothing changes until you hold Approve",
        "sub": "#{txId} · Hold to approve / Reject",
        "x": 30,
        "y": 20
      },
      "reject": {
        "txt": "Reject leaves the books untouched",
        "sub": "#{txId} stays {before}",
        "x": 30,
        "y": 20
      }
    }
  },
  "cardStart": "footage",
  "cardDetect": {
    "fps": 10,
    "lead": 4,
    "fraction": 0.5,
    "minMax": 5
  }
}
