# LLM Provider API Keys (at least one required)
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MOONSHOT_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Web Search (optional, priority: Exa > Perplexity > Tavily)
EXASEARCH_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key

# ── Docker / home server (docker-compose.yml) ───────────────────────────────
# Copy this file to .env next to docker-compose.yml. Only set what you need.

# Names or IPs you will type in the browser to reach the dashboard,
# comma-separated. Anything else is refused (DNS-rebinding protection).
# WILSON_LAN_HOSTS=nas.local,192.168.1.20

# Port on this machine. If you change it, open the dashboard by a name in
# WILSON_LAN_HOSTS (http://localhost only works on 3141).
# WILSON_HOST_PORT=3141

# Behind an HTTPS reverse proxy, add the public origin (and its host above):
# WILSON_DASHBOARD_ALLOWED_ORIGINS=https://wilson.example.com

# First-boot admin. Leave the password empty to get a random one, printed in
# `docker compose logs wilson`. Ignored once any dashboard user exists.
# WILSON_ADMIN_USERNAME=admin
# WILSON_ADMIN_PASSWORD=

# Chat model used until you pick one in Settings. With --profile local-ai the
# bundled Ollama serves OLLAMA_MODEL. In the container OLLAMA_BASE_URL (above)
# is ignored; set WILSON_OLLAMA_URL to use an Ollama elsewhere on your network.
# OLLAMA_MODEL=granite4.1:3b
# WILSON_DEFAULT_MODEL=ollama:granite4.1:3b
# WILSON_OLLAMA_URL=http://192.168.1.30:11434

# Use a specific image tag instead of :latest.
# WILSON_IMAGE=ghcr.io/openaccountant/wilson:0.10.1
