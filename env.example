# LLM Provider API Keys (at least one required)
OPENAI_API_KEY=your-api-key
ANTHROPIC_API_KEY=your-api-key
GOOGLE_API_KEY=your-api-key
XAI_API_KEY=your-api-key
OPENROUTER_API_KEY=your-api-key
MOONSHOT_API_KEY=your-api-key
DEEPSEEK_API_KEY=your-api-key

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Local LLM (any OpenAI-compatible server: llama.cpp, LM Studio, vLLM, TabbyAPI, ...)
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8080/v1
# Only needed if your server requires authentication
OPENAI_COMPATIBLE_API_KEY=

# Web Search (optional, priority: Exa > Perplexity > Tavily)
EXASEARCH_API_KEY=your-api-key
PERPLEXITY_API_KEY=your-api-key
TAVILY_API_KEY=your-api-key
