# ⚠️  SCRATCH probe from the May 2026 session — superseded by the September refresh.

Output /var/folders/ql/1gtlfs7n44x3r0d1_vqn96180000gn/T/demo-reel-XXXXXX.PfJXFp4Qkw/wilson-demo.gif

Set Shell "zsh"
Set Theme { "background": "#111827", "foreground": "#e5e7eb", "black": "#1f2937", "red": "#ef4444", "green": "#22c55e", "yellow": "#f59e0b", "blue": "#06b6d4", "magenta": "#a78bfa", "cyan": "#06b6d4", "white": "#e5e7eb", "brightBlack": "#374151", "brightRed": "#ef4444", "brightGreen": "#86efac", "brightYellow": "#f59e0b", "brightBlue": "#06b6d4", "brightMagenta": "#a78bfa", "brightCyan": "#67e8f9", "brightWhite": "#ffffff", "cursor": "#22c55e", "selection": "#374151" }
Set FontSize 16
Set Width 1080
Set Height 720
Set Padding 28
Set TypingSpeed 50ms

Hide
Type "export PATH=$HOME/.bun/bin:$PATH"
Enter
Type "cd /Users/jdfiscus/dev/oss/openaccoutant/wilson"
Enter
Type "export DEMO_DIR=data/demo"
Enter
Type "source data/demo/wilson-replay.sh"
Enter
Type "clear"
Enter
Show

Sleep 1500ms
Type "wilson 'Find any duplicate charges in May'"
Sleep 600ms
Enter
Sleep 7s
Type "wilson 'Where did my money go in May? Give me the top 4 categories.'"
Sleep 600ms
Enter
Sleep 7s
Sleep 2s
